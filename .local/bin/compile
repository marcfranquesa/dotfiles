#!/bin/sh

# back-end script that compiles/runs different programming languages

file="${1}"
ext="${file##*.}"
base="${file%.*}"

if [ -f "makefile" ] || [ -f "Makefile" ]; then
    make
    exit $?
fi

tex_compile() {
    if ! grep -qi "documentclass" "${file}"; then
        for file in *.tex; do
            if grep -qi "documentclass" "${file}"; then
                textarget="${file}"
                break
            fi
        done
        [ -z "$textarget" ] && textarget="main.tex"
    else
        textarget="${file}"
    fi

    # TeX resolves includes here; BibTeX requires a relative output stem.
    cd "$(dirname "$textarget")" || return
    textarget=$(basename "$textarget")
    set -- pdflatex -shell-escape -synctex=1 -interaction=nonstopmode -halt-on-error

    "$@" -draftmode "${textarget}" || return
    if grep -qiE "addbibresource|bibliography" "${textarget}"; then
        if grep -qi "backend=biber" "${textarget}"; then
            biber "${textarget%.*}" || return
        else
            bibtex "${textarget%.*}" || return
        fi
        "$@" -draftmode "${textarget}" || return
    fi
    "$@" "${textarget}"
}

md_compile() {
    pandoc --highlight-style=kate -s -o "${base}".pdf "${file}"
}

case "$ext" in
    md) md_compile ;;
    tex|bib|sty) tex_compile ;;
esac
