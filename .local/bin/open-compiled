#!/bin/sh

# back-end script that opens a compiled file

file="${1}"
[ -f "$file" ] || { printf 'Source file not found: %s\n' "$file" >&2; exit 1; }
file=$(realpath "$file")

ext="${file##*.}"
dir=$(dirname "$file")
base="${file%.*}"
synctex_editor="_zathura_inverse %{line} %{column} %{input}"

if [ -n "${NVIM_SERVER}" ]; then
    synctex_editor="_zathura_inverse --server=${NVIM_SERVER} %{line} %{column} %{input}"
fi

if command -v launchctl >/dev/null 2>&1; then
    dbus_socket=$(launchctl getenv DBUS_LAUNCHD_SESSION_BUS_SOCKET 2>/dev/null)
    if [ -z "${dbus_socket}" ]; then
        dbus_socket=$(launchctl asuser "$(id -u)" launchctl getenv DBUS_LAUNCHD_SESSION_BUS_SOCKET 2>/dev/null)
    fi
    if [ -z "${dbus_socket}" ]; then
        dbus_socket=$(launchctl print "gui/$(id -u)/org.freedesktop.dbus-session" 2>/dev/null |
            awk '/path = \/var\/run\/com\.apple\.launchd\..*\/unix_domain_listener/ { print $3; exit }')
    fi
    if [ -n "${dbus_socket}" ]; then
        export DBUS_LAUNCHD_SESSION_BUS_SOCKET="${dbus_socket}"
        export DBUS_SESSION_BUS_ADDRESS="unix:path=${dbus_socket}"
    fi
fi

zathura_open() {
    # Neovim already detaches this process; --fork can crash Cocoa on macOS.
    exec zathura "$@" </dev/null >/dev/null
}

link_pdf() {
    [ -n "${TMUX_PANE}" ] || return 0
    tmux set-option -pq -t "${TMUX_PANE}" @zathura_pdf "$(realpath "$1")"
}

find_pdf() {
    wanted="${base}.pdf"
    if [ -f "${wanted}" ]; then
        printf "%s\n" "${wanted}"
        return 0
    fi

    search_dir="${dir}"
    while :; do
        if [ -f "${search_dir}/main.pdf" ]; then
            printf "%s\n" "${search_dir}/main.pdf"
            return 0
        fi

        # A missing project PDF must not select a document from a parent project.
        [ -f "${search_dir}/main.tex" ] && break
        [ -e "${search_dir}/.git" ] && break
        [ "${search_dir}" = "/" ] && break
        parent_dir=$(dirname "${search_dir}")
        [ "${parent_dir}" = "${search_dir}" ] && break
        search_dir="${parent_dir}"
    done

    return 1
}

case "${ext}" in
md)
    [ -f "${base}.pdf" ] || { printf 'PDF not found: %s.pdf\n' "$base" >&2; exit 1; }
    link_pdf "${base}.pdf"
    zathura_open "${base}.pdf" &
    ;;
tex)
    line="${2}"
    column="${3:-1}"
    pdf=$(find_pdf) || { printf 'No compiled PDF for %s; compile the document first.\n' "$file" >&2; exit 1; }
    if [ -n "$line" ] && [ ! -s "${pdf%.pdf}.synctex.gz" ] && [ ! -s "${pdf%.pdf}.synctex" ]; then
        printf 'SyncTeX data missing for %s; compile with -synctex=1 first.\n' "$pdf" >&2
        exit 1
    fi
    link_pdf "${pdf}"

    if [ -n "${line}" ]; then
        zathura_open -x "${synctex_editor}" "--synctex-forward=${line}:${column}:${file}" "${pdf}"
    else
        zathura_open -x "${synctex_editor}" "${pdf}"
    fi
    ;;
*)
    printf 'Unsupported source type: %s\n' "$ext" >&2
    exit 1
    ;;
esac
